# Copy this file to backend/.env (same folder) and fill in your values — the backend
# reads it automatically. On a host like Render/Railway, put these in its
# "Environment" settings instead. Never commit the real .env file.
#
# Gmail example (needs 2-Step Verification ON, then create an "App password"
# at https://myaccount.google.com/apppasswords — use that, NOT your normal password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=yourname@gmail.com
# Reminders use the server's local clock — set this on your host so "10 minutes
# before" matches your college's time (e.g. India):
TZ=Asia/Kolkata
